# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side secrets live in Supabase, never in the app:
#   npx supabase secrets set ANTHROPIC_API_KEY=... GOOGLE_PLACES_API_KEY=...
