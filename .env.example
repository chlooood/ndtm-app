# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google sign-in (see README → Google sign-in and Calendar). Client IDs are public by design.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-ios.apps.googleusercontent.com
# Read by app.config.ts at build time (not bundled): the iOS client's reversed ID.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234-ios

# Server-side secrets live in Supabase, never in the app:
#   npx supabase secrets set ANTHROPIC_API_KEY=... GOOGLE_PLACES_API_KEY=...
