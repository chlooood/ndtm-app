{
  "expo": {
    "name": "ndtm",
    "slug": "ndtm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ndtm",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ndtm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFE8DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ndtm.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EFE8DA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ndtm reads the screenshots you pick to figure out where you want to go.",
          "cameraPermission": "ndtm uses the camera to scan posters, guidebooks and trail signs.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#EFE8DA"
  }
}
